{
  "name": "lemans2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "setup": "tsx scripts/setup-env.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:reset": "tsx --env-file=.env.local scripts/migrate.ts --reset && npm run db:seed",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "next build && playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
