# Copy to .env.local (npm run setup does this and generates SESSION_SECRET).
DATABASE_URL=postgres://lemans:changeme@localhost:5434/lemans

# HMAC key for session cookies. At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Demo mode enables simulated SSO, the demo clock and simulated trust signals.
# It must be false in any shared or hosted environment.
DEMO_MODE=true

# Comma-separated IPv4 CIDR ranges treated as the IRAS office network (non-demo mode).
OFFICE_CIDRS=10.0.0.0/8

# Business rules
COVERAGE_FLOOR=0.8
ATTENDANCE_FLOOR=0.85
MISSING_CHECKIN_ALERT_TIME=12:00
